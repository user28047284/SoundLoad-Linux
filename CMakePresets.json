{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-static",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-static-release",
      "displayName": "Windows x64 static (Release)",
      "inherits": "windows-static",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-static-debug",
      "displayName": "Windows x64 static (Debug)",
      "inherits": "windows-static",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "windows-static-release", "configurePreset": "windows-static-release" },
    { "name": "windows-static-debug", "configurePreset": "windows-static-debug" }
  ]
}
